# This repository is a public-facing GitOps source of truth. Nothing in it is
# ever decrypted at apply time, so a real credential committed here is a real
# leak. These rules are a backstop, not the workflow: the documented path in
# environments/<env>/argocd/README.md copies the example out to /tmp and edits
# it there, so a secret-shaped file inside the repo already means something
# went sideways.

# Argo CD repository Secrets carry a live sshPrivateKey. The *.example.yaml
# templates are the only secret-shaped files that belong in Git.
*secret.yaml
*secret.yml
*secrets.yaml
*secrets.yml
!*.example.yaml
!*.example.yml

# NOTE: if this repository ever adopts Sealed Secrets or SOPS, those encrypted
# manifests are meant to be committed and the rules above would silently ignore
# them. Add explicit negations at that point rather than loosening the globs.

# Cluster and Talos access artifacts. They are generated by talos-toolchain and
# belong under its ignored project directories, never here.
kubeconfig
talosconfig
*.kubeconfig
*.talosconfig

# Local Helm render scratch. The validate-*.sh scripts use mktemp outside the
# repository, so this only catches hand-run `helm template > out.yaml`.
/tmp/
*.rendered.yaml
